#!/usr/bin/env bash
# init
jobname="PRV"
time="02:00:00"
mem="20Gb"
constraint="medmem"

function usage () {
echo "Usage: providentia [-u|--usage] [-c|--n_cpus)]"
echo "    [-J|--jobname JOB_NAME (default=PRV)] [-q|--queue QUEUE_NAME (default=debug)]"
echo "    [-m|--mem MEMORY (only valid on P9, default=20Gb)]"
echo "    [--constraint CONSTRAINT (default=medmem)]"
}

# check we are using GNU getopt
out=$(getopt -T)
if (( $? != 4 )) && [[ -n $out ]]; then
    echo "GNU getopt is required to run Providentia."
    echo "On MacOS this can be installed using Homebrew: brew install gnu-getopt"
    echo "If Homebrew is not installed, see here: https://brew.sh"
    echo "On other platforms it should be built from source: https://frodo.looijaard.name/project/getopt"
    echo "After installation, a line to pass the location of the gnu-getopt executable to the PATH must be added to your .zshrc (Mac) or .bashrc (Linux) file."
    echo 'For example: export PATH="/opt/homebrew/opt/gnu-getopt/bin:$PATH"'
    exit 1
fi

# get OS
#Mac OS X platform        
if [ "$(uname)" == "Darwin" ]; then
    OS="Mac"        
#GNU/Linux platform
elif [ "$(expr substr $(uname -s) 1 5)" == "Linux" ]; then
    OS="Linux"
# Windows platform
elif [ "$(expr substr $(uname -s) 1 10)" == "Windows" ] || [ "$(expr substr $(uname -s) 1 10)" == "MINGW32_NT" ] || [ "$(expr substr $(uname -s) 1 10)" == "MINGW64_NT" ]; then
    OS="Windows"
else
    echo "The OS cannot be detected. Exiting."
    exit 1
fi

# bash strict mode: see http://redsymbol.net/articles/unofficial-bash-strict-mode/ for info
set -eo pipefail
IFS=$'\n\t'

sanitise_python_environment() {
    echo "INFO: Sanitising Python environment..."

    unset PYTHONPATH || true
    unset PYTHONHOME || true
    unset PYTHONSTARTUP || true
    unset PYTHONUSERBASE || true

    export PYTHONNOUSERSITE=1
}

# install shell tab-completion for --conf=/--config=/--config_dir= once, self-healing
# if the repo is deleted and re-cloned to a different path
install_completion() {
    local marker="# providentia-completion (auto-added)"
    local comp_script="${script_dir}/completion/providentia-completion.sh"
    local rc_file="$HOME/.bashrc"
    [[ "$(basename "${SHELL:-}")" == "zsh" ]] && rc_file="$HOME/.zshrc"

    [[ -f "$comp_script" ]] || return 0   # nothing to install
    [[ -f "$rc_file" ]] || touch "$rc_file"

    local line="source \"$comp_script\" $marker"

    if grep -qF "$marker" "$rc_file" 2>/dev/null; then
        # already installed and path unchanged - stay completely silent
        if ! grep -qF "$comp_script" "$rc_file"; then
            # repo was moved/re-cloned to a new path - refresh silently except for this notice
            grep -vF "$marker" "$rc_file" > "${rc_file}.tmp" && mv "${rc_file}.tmp" "$rc_file"
            echo "$line" >> "$rc_file"
            echo "INFO: Providentia tab-completion path changed. To use it in this terminal, run:"
            echo "source \"$rc_file\""
        fi
    else
        echo "$line" >> "$rc_file"
        echo "INFO: Providentia tab-completion (--conf=<TAB>, --config=<TAB>) installed in $rc_file."
        echo "It will be active automatically in any new terminal."
        echo "To use it in this terminal right now, run:"
        echo "source \"$rc_file\""
    fi
}

# resolve repo root early so install_completion (and later uses) can rely on it
script_dir=$(dirname $(realpath $(dirname $0)))

# sanitise python environment to avoid conflicts
sanitise_python_environment

# install/refresh shell tab-completion for conf file arguments (no-op after first run)
install_completion

# An option followed by a single colon ':' means that it *needs* an argument.
# An option followed by double colons '::' means that its argument is optional.
# See `man getopt'.
SHORT=uc:t:J:q:m:V
LONG=usage,n_cpus:,time:,jobname:,queue:,mem:,constraint:,help,version,debug,clean,section:,ghost_version:,ghost_features:,conf:,config:,config_dir:,cartopy_data_dir:,ghost_root:,nonghost_root:,exp_root:,exp_to_interp_root:,generate_file_tree,gft,disable_file_tree,dft,report,reports,offline,download,dl,interpolation,interp,interpolate,notebook,nb,jupyter,dir_merge,slurm_job_id:,network:,framework:,observation:,species:,resolution:,model_resolution:,start_date:,end_date:,observations_data_label:,experiments:,experiment:,model:,models:,domain:,ensemble:,forecast:,qa:,flags:,add_qa:,subtract_qa:,add_flags:,subtract_flags:,temporal_colocation:,spatial_colocation:,spatial_colocation_tolerance:,spatial_colocation_station_reference:,spatial_colocation_station_name:,spatial_colocation_longitude_latitude:,spatial_colocation_measurement_altitude:,spatial_colocation_validation:,spatial_colocation_validation_tolerance:,map_extent:,filter_species:,calibration_factor:,lower_bound:,upper_bound:,remove_extreme_stations:,report_type:,report_summary:,report_stations:,report_title:,report_filename:,harmonise_summary:,harmonise_stations:,active_dashboard_plots:,resampling_resolution:,statistic_mode:,statistic_aggregation:,periodic_statistic_mode:,periodic_statistic_aggregation:,timeseries_statistic_aggregation:,plot_characteristics_filename:,dl_overwrite:,dl_ghost_source:,dl_interpolated:,dl_mode:,dl_timeout:,dl_thredds_update:,interp_multiprocessing:,interp_n_neighbours:,interp_reverse_vertical_orientation:,interp_chunk_size:,interp_job_array_limit:,interp_cleanup:,interp_spinup_timesteps:,z:,interp_model_downsampling:,interp_model_upsampling:,logfile::,multispecies_units:,station_order:,station_cap:

# parse arguments
PARSED=$(getopt --options ${SHORT} \
                --longoptions ${LONG} \
                --name "$0" \
                -- "$@")         # pass all the args to this script to getopt
# exit if getopt has complained about wrong arguments to stdout
if [[ $? -ne 0 ]]; then
    exit 2
fi

# define default number of cpus
# 24 for interpolation mode
if [[ $PARSED =~ "--interp" || $PARSED =~ "--interpolation" || $PARSED =~ "--interpolate"  ]]; then
    n_cpus=24
# 12 for download mode
elif [[ $PARSED =~ "--download" || $PARSED =~ "--dl" ]]; then
    n_cpus=12
# 1 for dashboard and report modes
else
    n_cpus=1
fi
n_cpus_explicit=false

# set qos depending on the mode and machine
if [[ $PARSED =~ "--interp" || $PARSED =~ "--interpolation" || $PARSED =~ "--interpolate" ]]; then
    # define qos in interpolation
    if [ "${BSC_MACHINE}" == "mn5" ]; then
        queue="gp_bsces"
    elif [ "${BSC_MACHINE}" == "grace" ]; then
        queue="ngp_bsces"
    else
        queue="bsc_es"
    fi
else    
    # define qos in every mode but interpolation
    if [ "${BSC_MACHINE}" == "mn5" ]; then
        queue="gp_debug"
    elif [ "${BSC_MACHINE}" == "grace" ]; then
        queue="ngp_debug"
    else
        queue="debug"
    fi 
fi

# reset SLURM_EXPORT_ENV so that things like srun & sbatch work out of the box
export SLURM_EXPORT_ENV=ALL

# workaround to stop driver conflict issue 
#export QT_QPA_PLATFORM_PLUGIN_PATH=/gpfs/home/bsc/${USER}/.conda/envs/providentia-env/lib/python3.9/site-packages/PyQt5/Qt5/plugins

# update key arguments for job submission
OTHEROPTS=""
while [ $# -gt 0 ]; do
  # parse equals sign in arguments
  OPT="$1"
  if [[ $OPT == *"="* ]]; then
      OPTNAME=${OPT%=*}
      OPTARG=${OPT#*=}
  else
      OPTNAME=$OPT 
      OPTARG=""
  fi
  case $OPTNAME in
        -u|--usage) shift
                    usage 
                    exit 0
                    ;;
        -c|--n_cpus) shift
                    n_cpus=$OPTARG
                    n_cpus_explicit=true
                    OTHEROPTS+="--n_cpus=$OPTARG "
                    ;;
        -t|--time) shift
                    time=$OPTARG;;
        -J|--jobname) shift
                    jobname=$OPTARG;;
        -q|--queue) shift
                    queue=$OPTARG;;
        -m|--mem) shift
                    mem=$OPTARG;;
        --constraint) shift 
                    constraint=$OPTARG;;            
        -*) shift
            OTHEROPTS+="$OPT ";;
        * ) echo "ERROR: All options must be prefixed with '-' or '--', and arguments must be prefixed '=', e.g. '--n_cpus=10'" 
            exit 2
  esac
done

account_option="--account=bsc32"
queue_option="--qos=$queue"
memory_option="--mem=$mem"
n_cpus_option="--cpus-per-task=$n_cpus"
n_cpus_explicit_option="--n_cpus_explicit=$n_cpus_explicit"
constraint_option="--constraint=$constraint"
load_command="source bin/load_modules.sh"
notebook_alloc_command="sbatch -t $time -c $n_cpus -J $jobname"

# use python 3 if not in windows
if [[ "${OS}" != "Windows" ]] ; then 
    python_ver="3"
fi

# if using Mac, then use Providentia executable (in order to rename application name)
if [[ "${OS}" == "Mac" ]] ; then
    python_command="./bin/Mac/Providentia -E -s -u -Wi -c 'from providentia import main;main.main()' $OTHEROPTS"
else
    python_command="python$python_ver -E -s -u -Wi -c 'from providentia import main;main.main()' $OTHEROPTS"
fi

# use clean mode and exit
if [[ $PARSED =~ "--clean" ]]; then
    bash bin/clean_output.sh
    exit 0
fi

# Avoid x11 forwarding when creating reports or doing interpolations
if [[ $PARSED =~ "--report" || $PARSED =~ "--reports" || $PARSED =~ "--offline" || $PARSED =~ "--download" || $PARSED =~ "--dl" ]]; then
    salloc_command="salloc -t $time -c $n_cpus -J $jobname"
elif [[ $PARSED =~ "--interp" || $PARSED =~ "--interpolation" || $PARSED =~ "--interpolate" ]]; then
    salloc_command="salloc -t $time -c 1 -J $jobname"
# For dashboard, use x11 forwarding
else
    salloc_command="salloc -t $time -c $n_cpus -J $jobname --x11"
fi

# if using debug mode then just reserve allocation, do not execute providentia
if [[ $PARSED =~ "--debug" ]]; then
    debug=true
else
    debug=false
fi

# remind users to use notebook instead of interactive
if [[ $PARSED =~ "--interactive" ]]; then
    echo "ERROR: Interactive mode has been renamed to notebook, please use --notebook to open a Jupyter session. Exiting..."
    exit 1
fi

# if using notebook mode then 
if [[ $PARSED =~ "--notebook" || $PARSED =~ "--nb" || $PARSED =~ "--jupyter" ]]; then
    notebook=true
else
    notebook=false
fi

# if using interpolation mode then
if [[ $PARSED =~ "--interp" || $PARSED =~ "--interpolation" || $PARSED =~ "--interpolate" ]]; then
    interpolation=true
else
    interpolation=false
fi

# if using download mode then 
if [[ $PARSED =~ "--download" || $PARSED =~ "--dl" ]]; then
    download=true
else
    download=false
fi

# if using download mode then 
if [[ $PARSED =~ "--report" || $PARSED =~ "--reports" || $PARSED =~ "--offline" ]]; then
    report=true
else
    report=false
fi

# check for incompatible modes
mode_bools=("$debug" "$notebook" "$interpolation" "$download" "$report")
mode_count=0

for i in "${!mode_bools[@]}"; do
    val="${mode_bools[$i]}"
    if [[ "$val" == true ]]; then
        ((++mode_count))
    fi
done

if (( mode_count >= 2 )); then
    echo "ERROR: incompatible mode arguments detected. Please select only one mode." 
    exit 1
fi

# determine if need to just execute python if have allocation made (i.e. are in debug mode)
VALID_HOSTS="p9login1 login0 login1 login2 login3 login4 glogin1 glogin2 glogin3 glogin4 nglogin1 nglogin2 nglogin3 nglogin4"
HOST=`hostname`
if [[ " $VALID_HOSTS " =~ .*\ $HOST\ .* ]]; then
    debugexec=false
else
    debugexec=true
fi


# get IP (different method for each OS)
if [ "${OS}" == "Mac" ]; then
    ip=${LOCAL_IP:-$(ipconfig getifaddr en0 2>/dev/null || echo "")}
elif [ "${OS}" == "Linux" ]; then
    ip=$(hostname --ip-address)
elif [ "${OS}" == "Windows" ]; then
    ip=${LOCAL_IP:-$(ipconfig.exe | grep -im1 'IPv4 Address' | cut -d ':' -f2)}
fi

# if download mode is executed from the remote machines, exit
if $download; then
    if [[ "${BSC_MACHINE}" == "mn5" || "${BSC_MACHINE}" == "84.88.185.48" ]]; then
        echo "Download mode not available in $BSC_MACHINE. Exiting..."
        exit 1
    fi
fi

# activate or create the conda environment for local and operational machines
ENV_NAME="providentia-env_v3.1.0"
setup_providentia_env_locally() {
    active_env=false
    eval "$(conda shell.bash hook)"

    # check if environment exists
    if conda env list | grep -q "^$ENV_NAME"; then
        echo "INFO: Activating conda environment $ENV_NAME..."
        conda activate "$ENV_NAME"
        export LD_LIBRARY_PATH="$CONDA_PREFIX/lib:$LD_LIBRARY_PATH"
        active_env=true
    else
        # create it if it doesn't exist
        echo "INFO: Environment $ENV_NAME does not exist."
        echo "INFO: Creating environment..."

        # ensure conda-forge is in channels
        if ! conda config --show channels 2>/dev/null | grep -q 'conda-forge'; then
            echo "INFO: Adding conda-forge channel..."
            conda config --append channels conda-forge
        fi

        # create environment
        conda create -n "$ENV_NAME" python=3.11.5 -c conda-forge --override-channels -y
        conda activate "$ENV_NAME"
        export LD_LIBRARY_PATH="$CONDA_PREFIX/lib:$LD_LIBRARY_PATH"
        conda install -c conda-forge cartopy==0.25.0 jupyterlab==4.5.3 ghostscript==10.06.0 dask==2026.1.2 nco==5.3.6 pyproj==3.7.2 proj==9.7.1 --override-channels -y
        if [ -f requirements.txt ]; then
            pip install --no-user -r requirements.txt
        fi
        active_env=true
    fi
}

# function to initialize conda if not already initialised
initialise_conda() {

    # initialize conda in windows
    if [ "${OS}" == "Windows" ] ; then 
        CONDA_PATH="$HOME/anaconda3"

        __conda_setup="$("$CONDA_PATH/condabin/conda" 'shell.bash' 'hook' 2> /dev/null)"
        
        if [ $? -eq 0 ]; then
            eval "$__conda_setup"
            echo "INFO: Conda initialised successfully"
        else
            if [ -f "$CONDA_PATH/etc/profile.d/conda.sh" ]; then
                . "$CONDA_PATH/etc/profile.d/conda.sh"
            else
                export PATH="$CONDA_PATH/condabin:$PATH"
            fi
        fi
        unset __conda_setup
    else
        if type conda 2>/dev/null | grep -q "function"; then 
            echo "INFO: Conda not initialised. Running conda init..."
            conda init bash
            source ~/.bashrc
        else 
            echo "INFO: Conda initialised successfully"; 
        fi

    fi
}

# execution
# Marenostrum5
if [ "${BSC_MACHINE}" == "mn5" ]; then

    echo "INFO: Running on MN5..."

    module load anaconda
    # initialize conda if not already initialised
    initialise_conda

    if $interpolation; then
        echo "OPTIONS: n_cpus: ${n_cpus}, jobname: ${jobname}, queue: ${queue}, mem: ${mem}"
        echo "INFO: Loading dependencies..."
        eval "${load_command}"
        sanitise_python_environment
        jobid=$(eval "sbatch ${n_cpus_option} ${account_option} ${queue_option} bin/submit_interpolation_${BSC_MACHINE}.sh $OTHEROPTS | awk '{print \$4}'")
        echo "INFO: Check submission info in 'logs/interpolation/management_logs/$jobid.out'"

    else
        # load modules from conda environment
        active_env=false
        sanitise_python_environment
        eval "$(conda shell.bash hook)"
        conda config --set env_prompt '($(basename {default_env})) '
        if ! { conda config --show-sources | grep '/gpfs/projects/bsc32/repository/apps/conda_envs/'; } >/dev/null 2>&1; then
            conda config --append envs_dirs /gpfs/projects/bsc32/repository/apps/conda_envs/
        fi
        if { conda env list | grep $ENV_NAME; } >/dev/null 2>&1; then 
            echo "INFO: Activating conda environment in /gpfs/projects/bsc32/repository/apps/conda_envs/$ENV_NAME..."
            conda activate $ENV_NAME
            export LD_LIBRARY_PATH="$CONDA_PREFIX/lib:$LD_LIBRARY_PATH"
            active_env=true
        else 
            echo "ERROR: Environment not found in /gpfs/projects/bsc32/repository/apps/conda_envs/, please contact the developers."
        fi

        if $active_env; then
            if $notebook; then
                echo "OPTIONS: n_cpus: ${n_cpus}, jobname: ${jobname}, queue: ${queue}, constraint: ${constraint}"
                echo "INFO: Starting Jupyter session."
                echo "INFO: Check 'notebook.out' for information on how to connect to session."
                
                if [[ "${constraint}" == "lowmem" ||  "${constraint}" == "medmem" ]]; then
                    eval "${notebook_alloc_command} ${account_option} ${queue_option} bin/notebook.sh"
                else
                    eval "${notebook_alloc_command} ${account_option} ${constraint_option} ${queue_option} bin/notebook.sh"
                fi

            elif $debug; then
                echo "OPTIONS: n_cpus: ${n_cpus}, jobname: ${jobname}, queue: ${queue}, constraint: ${constraint}"
                echo "INFO: Entering debug mode"
                if [[ "${constraint}" == "lowmem" ||  "${constraint}" == "medmem" ]]; then
                    eval "${salloc_command} ${account_option} ${queue_option}"
                else
                    eval "${salloc_command} ${account_option} ${constraint_option} ${queue_option}"
                fi
            
            else
                if $debugexec; then
                    eval "srun ${account_option} ${python_command}"
                else
                    echo "OPTIONS: n_cpus: ${n_cpus}, jobname: ${jobname}, queue: ${queue}, constraint: ${constraint}"
                    if [[ "${constraint}" == "lowmem" ||  "${constraint}" == "medmem" ]]; then
                        eval "${salloc_command} ${account_option} ${queue_option} srun ${python_command}"
                    else
                        eval "${salloc_command} ${account_option} ${constraint_option} ${queue_option} srun ${python_command}"
                    fi
                fi
            fi
        fi
    fi

# storage5
elif [[ "${BSC_MACHINE}" == "stg" ]]; then
    echo "INFO: Running on the storage5..."

    # initialize conda if not already initialised
    initialise_conda

    # load modules from conda environment
    active_env=false
    eval "$(conda shell.bash hook)"
    if { conda env list | grep $ENV_NAME; } >/dev/null 2>&1; then 
        echo "INFO: Activating conda environment..."
        conda activate $ENV_NAME
        export LD_LIBRARY_PATH="$CONDA_PREFIX/lib:$LD_LIBRARY_PATH"
        active_env=true
    else 
        echo "ERROR: Environment not found in /gpfs/projects/bsc32/repository/apps/conda_envs/, please contact the developers."
    fi

    if $active_env; then
        if $download; then
            eval "${python_command}"
        else
            echo "ERROR: Mode not available in storage5."
        fi
    fi

# Nord4
elif [ "${BSC_MACHINE}" == "nord4" ]; then
    echo "INFO: Running on ${BSC_MACHINE}..."

    module load Miniconda3/24.7.1-0
    # initialize conda if not already initialised
    initialise_conda

    if $interpolation; then
        echo "OPTIONS: n_cpus: ${n_cpus}, jobname: ${jobname}, queue: ${queue}, mem: ${mem}"
        echo "INFO: Loading dependencies..."
        eval "${load_command}"
        sanitise_python_environment
        jobid=$(eval "sbatch ${n_cpus_option} ${account_option} ${queue_option} bin/submit_interpolation_${BSC_MACHINE}.sh $OTHEROPTS | awk '{print \$4}'")
        echo "INFO: Check submission info in 'logs/interpolation/management_logs/$jobid.out'"

    else
        # load modules from conda environment
        active_env=false
        sanitise_python_environment
        eval "$(conda shell.bash hook)"
        conda config --set env_prompt '($(basename {default_env})) '
        if ! { conda config --show-sources | grep '/gpfs/projects/bsc32/repository/apps/conda_envs/'; } >/dev/null 2>&1; then
            conda config --append envs_dirs /gpfs/projects/bsc32/repository/apps/conda_envs/
        fi
        if { conda env list | grep "$ENV_NAME-nord4"; } >/dev/null 2>&1; then 
            echo "INFO: Activating conda environment in /gpfs/projects/bsc32/repository/apps/conda_envs/$ENV_NAME-nord4..."
            conda activate $ENV_NAME-nord4
            export LD_LIBRARY_PATH="$CONDA_PREFIX/lib:$LD_LIBRARY_PATH"
            active_env=true
        else 
            echo "ERROR: Environment not found in /gpfs/projects/bsc32/repository/apps/conda_envs/, please contact the developers."
        fi

        if $active_env; then
            if $notebook; then
                echo "OPTIONS: n_cpus: ${n_cpus}, jobname: ${jobname}, queue: ${queue}, constraint: ${constraint}"
                echo "INFO: Starting Jupyter session."
                echo "INFO: Check 'notebook.out' for information on how to connect to session."
                
                if [[ "${constraint}" == "lowmem" ||  "${constraint}" == "medmem" ]]; then
                    eval "${notebook_alloc_command} ${account_option} ${queue_option} bin/notebook.sh"
                else
                    eval "${notebook_alloc_command} ${account_option} ${constraint_option} ${queue_option} bin/notebook.sh"
                fi

            elif $debug; then
                echo "OPTIONS: n_cpus: ${n_cpus}, jobname: ${jobname}, queue: ${queue}, constraint: ${constraint}"
                echo "INFO: Entering debug mode"
                if [[ "${constraint}" == "lowmem" ||  "${constraint}" == "medmem" ]]; then
                    eval "${salloc_command} ${account_option} ${queue_option}"
                else
                    eval "${salloc_command} ${account_option} ${constraint_option} ${queue_option}"
                fi
            
            else
                if $debugexec; then
                    eval "srun ${account_option} ${python_command}"
                else
                    echo "OPTIONS: n_cpus: ${n_cpus}, jobname: ${jobname}, queue: ${queue}, constraint: ${constraint}"
                    if [[ "${constraint}" == "lowmem" ||  "${constraint}" == "medmem" ]]; then
                        eval "${salloc_command} ${account_option} ${queue_option} srun nord3_singu_es ${python_command}"
                    else
                        eval "${salloc_command} ${account_option} ${constraint_option} ${queue_option} srun nord3_singu_es ${python_command}"
                    fi
                fi
            fi
        fi
    fi

# Oper machine
elif [ "${ip}" == "84.88.185.205" ]; then
    echo "INFO: Running on operational machine..."
    
    module load Miniconda3/24.7.1-0
    # initialize conda if not already initialised
    initialise_conda
    sanitise_python_environment
    setup_providentia_env_locally

    if $notebook; then
        echo "INFO: Starting Jupyter session."
        export PYTHONPATH="$(pwd)"
        jupyter-lab --port 8888 --ip 0.0.0.0 --allow-root
    elif $interpolation; then
        unique_id=$(printf "%06d\n" $((RANDOM % 1000000)))
        eval "${python_command} ${n_cpus_option} ${n_cpus_explicit_option} --slurm_job_id=$unique_id" 2>&1 | tee logs/interpolation/management_logs/$unique_id.out
    else
        eval "${python_command} ${n_cpus_option} ${n_cpus_explicit_option}"
    fi

# Local machines (Workstations, dust02 machine and personal laptops)
else
    echo "INFO: Running on a local machine..."
    
    # check if conda is installed
    if ! command -v conda >/dev/null 2>&1; then
        echo "ERROR: Conda is not installed, please read the instructions on how to get started at https://providentia.readthedocs.io/en/latest/Getting-started.html."
        exit 1
    fi

    # initialize conda if not already initialised
    initialise_conda

    # load modules from conda environment
    setup_providentia_env_locally

    # merge exp and exp_to_interp directories to mod and mod_to_interp       
    if [[ $PARSED =~ "--dir_merge" ]]; then
        python providentia/dir_merge.py
        exit 1
    fi

    # if are using Mac then create a Providentia executable
    if [[ "${OS}" == "Mac" ]]; then
        python_exe=$(which python)
        target="bin/Mac/Providentia"

        # create a new executable if it does not exist yet
        if [[ ! -f "$target" ]]; then
            cp "$python_exe" "$target"
        # if it exists check if it is the same executable as previous
        else
            # if not, then overwrite it
            if ! cmp -s "$python_exe" "$target"; then
                cp "$python_exe" "$target"
            fi
        fi
    fi

    if $notebook; then
        echo "INFO: Starting Jupyter session."
        export PYTHONPATH="$(pwd)"
        jupyter-lab --port 8888 --ip 0.0.0.0 --allow-root
    elif $interpolation; then
        unique_id=$(printf "%06d\n" $((RANDOM % 1000000)))
        eval "${python_command} ${n_cpus_option} ${n_cpus_explicit_option} --slurm_job_id=$unique_id" 2>&1 | tee logs/interpolation/management_logs/$unique_id.out
    else
        eval "${python_command} ${n_cpus_option} ${n_cpus_explicit_option}"
    fi
fi